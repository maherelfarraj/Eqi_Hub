{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equivista.net/schemas/phase1-production-preflight.schema.json",
  "title": "EquiVista Phase 1 production preflight snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "observed_at",
    "environment",
    "totals",
    "organizations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "environment": { "const": "production-controlled-pilot" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_users",
        "confirmed_auth_users",
        "profiles",
        "active_memberships"
      ],
      "properties": {
        "auth_users": { "type": "integer", "minimum": 0 },
        "confirmed_auth_users": { "type": "integer", "minimum": 0 },
        "profiles": { "type": "integer", "minimum": 0 },
        "active_memberships": { "type": "integer", "minimum": 0 }
      }
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_ref",
          "active_members",
          "distinct_required_role_users",
          "roles",
          "relationships"
        ],
        "properties": {
          "organization_ref": { "type": "string", "minLength": 1 },
          "active_members": { "type": "integer", "minimum": 0 },
          "distinct_required_role_users": {
            "type": "integer",
            "minimum": 0
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rider", "guardian", "coach", "academy_admin"],
            "properties": {
              "rider": { "type": "integer", "minimum": 0 },
              "guardian": { "type": "integer", "minimum": 0 },
              "coach": { "type": "integer", "minimum": 0 },
              "academy_admin": { "type": "integer", "minimum": 0 }
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "active_guardian_rider_links",
              "active_coach_rider_links",
              "active_horse_access_assignments"
            ],
            "properties": {
              "active_guardian_rider_links": {
                "type": "integer",
                "minimum": 0
              },
              "active_coach_rider_links": {
                "type": "integer",
                "minimum": 0
              },
              "active_horse_access_assignments": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
