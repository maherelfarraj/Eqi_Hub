    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
