{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://equivista.net/schemas/batch18-archive-recovery.schema.json",
  "title": "EquiVista Batch 18 Offline Archive Recovery", "type": "object", "additionalProperties": false,
  "required": ["version", "batch", "mode", "status", "archive_contract_version", "recovery_contract_version", "approved_batch17_archive_hash", "rejection_codes", "safety", "fixtures", "evidence_ref"],
  "properties": { "version": { "const": 1 }, "batch": { "const": 18 }, "mode": { "const": "offline-archive-recovery" }, "status": { "const": "in-progress" }, "archive_contract_version": { "const": "evidence-archive-v1" }, "recovery_contract_version": { "const": "archive-recovery-v1" }, "approved_batch17_archive_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "rejection_codes": { "type": "array", "uniqueItems": true }, "safety": { "type": "object" }, "fixtures": { "type": "array", "minItems": 6 }, "evidence_ref": { "type": "string", "pattern": "^docs/" } }
}
